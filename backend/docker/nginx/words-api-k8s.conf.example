# Host nginx in front of the k3s cluster (see k8s/README.md).
#
# Everything is proxied to the app Service's NodePort; public/ and PHP are
# served by the nginx container inside the pod.
#
#   sed -e "s|__DOMAIN__|api-words.litruk.dev|g" \
#       docker/nginx/words-api-k8s.conf.example | sudo tee /etc/nginx/sites-available/words-api
#   sudo ln -sfn /etc/nginx/sites-available/words-api /etc/nginx/sites-enabled/words-api
#   sudo nginx -t && sudo systemctl reload nginx
#   sudo certbot --nginx -d __DOMAIN__     # if the TLS block is not there yet

server {
    listen 80;
    listen [::]:80;
    server_name __DOMAIN__;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name __DOMAIN__;

    # certbot manages these two lines.
    # ssl_certificate     /etc/letsencrypt/live/__DOMAIN__/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/__DOMAIN__/privkey.pem;

    client_max_body_size 1m;

    access_log /var/log/nginx/words-api.access.log;
    error_log  /var/log/nginx/words-api.error.log;

    add_header X-Content-Type-Options "nosniff" always;

    location / {
        # NodePort of the `app` Service in k8s/40-app.yaml. receipt-app's
        # cluster already uses 30080 on this node.
        proxy_pass http://127.0.0.1:30081;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        # The in-pod nginx turns this into the HTTPS fastcgi param.
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;

        proxy_read_timeout 60s;
    }
}
