# Backend GraphQL endpoint. QCLI_ is the prefix Quasar injects into client
# code (quasar.config.ts > build > envClientPrefix); a VITE_ prefixed variable
# is silently ignored here, since Quasar disables Vite's own dotenv handling.
# QCLI_API_URL=https://api-words.litruk.dev/graphql

# Local development against Sail. On a real device connected via USB, run
# `adb reverse tcp:8090 tcp:8090` so the phone's localhost:8090 reaches the
# Mac's Sail container.
QCLI_API_URL=http://localhost:8090/graphql
